# Modele des variables. Recopie les blocs utiles dans DEUX fichiers :
# - .env.local (racine) : scripts et CLI (npm run dev, check-integrations).
# - web/.env.local : application Next.js (elle ne voit QUE son dossier).
# Les cles presentes des deux cotes doivent avoir la MEME valeur.
# Racine : MODEL_API_KEY + DATABASE_URL sont lus dans .env (Prisma CLI).
# --- Cle Model API (dashboard Meta) : recopiee dans .env et .env.local ---
MODEL_API_KEY=
# --- Routeur : utilisateur LECTURE SEULE pour le diagnostic ---
ROUTEROS_URL=
ROUTEROS_USER=
ROUTEROS_PASS=
# --- TLS : certificat verifie par defaut. Labo autosigne uniquement via
# ROUTEROS_TLS_INSECURE=1 (jamais en production, avertissement affiche). ---
# ROUTEROS_TLS_INSECURE=
# --- Routeur : utilisateur ECRITURE pour les correctifs (separe !) ---
ROUTEROS_FIX_USER=
ROUTEROS_FIX_PASS=
# --- Base de donnees ---
DATABASE_URL=
# --- n8n (fonction 2) ---
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=
N8N_CALLBACK_SECRET=
# Cle d'API n8n (avatar -> Settings -> onglet "n8n API") : publication
# des workflows via scripts/n8n/publier-workflow.py. Serveur uniquement.
N8N_API_KEY=
# --- URL publique de VOTRE app (pour les retours de n8n) ---
APP_URL=
# --- Chiffrement des secrets en base (32 octets en hexadecimal) ---
# Generer avec : openssl rand -hex 32
CHIFFREMENT_CLE=
# --- Bot Telegram central (mode "central") : jeton serveur uniquement ---
TELEGRAM_BOT_TOKEN=
# --- n8n cote routeur (vues depuis le conteneur n8n si besoin) ---
N8N_ROUTER_BASE_URL=
N8N_ROUTER_USER=n8n-vouchers
N8N_ROUTER_PASS=
# --- Retours n8n et taches planifiees : secret serveur uniquement ---
CRON_SECRET=
# --- Sessions du frontend (web/.env.local) : signe les cookies. ---
# Courriels superadmin (supervision des utilisateurs), séparés par des virgules.
SUPERADMIN_COURRIELS=
# Webhook adaptateur pour le code de validation WhatsApp a l'inscription.
WHATSAPP_OTP_WEBHOOK_URL=
WHATSAPP_OTP_SECRET=
# Lien du groupe WhatsApp ou Telegram montré après l'inscription (vide = aucun).
LIEN_COMMUNAUTE=
SESSION_SECRET=
# --- Mikhmon : valeurs proposees dans le formulaire, jamais en dur ---
# Variante proposee par defaut : v3 ou sf-v1.
MIKHMON_VARIANT=v3
# Hote propose dans le formulaire (ex. local : http://127.0.0.1:8088).
# L'utilisateur le confirme ou le change ; le code ne fige aucune adresse.
MIKHMON_BASE_URL=
# --- Tickets Telegram : limites Hotspot optionnelles (chaines RouterOS, ex. "3d"). Absentes = sans limite. ---
# LIMIT_UPTIME=
# LIMIT_BYTES_TOTAL=
# --- n8n (conteneur Docker, docker-compose) : PAS dans ce fichier ---
# Ces noms sont lus par les workflows via $env / env() : renseigne-les
# dans l'environnement du conteneur n8n, jamais ici, jamais dans Git.
# Routeur vu depuis n8n (host.docker.internal sur macOS Docker) :
# ROUTEROS_BASE_URL=
# ROUTEROS_USER=
# ROUTEROS_PASSWORD=
# Telegram (repli global ; le par-utilisateur vit en base, chiffre) :
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_ID=
# Securite des echanges n8n <-> SafeLink-Auto-Pilot :
# N8N_WEBHOOK_SECRET=
# N8N_CALLBACK_SECRET=
# Cle d'API n8n (publication des workflows, jamais dans Git) :
# N8N_API_KEY=
# APP_URL=
# SIMULATION=true pour tester sans ecrire sur le routeur.
# SIMULATION=
# REAPPRO_SIMULATION=
# Routeur et Mikhmon vus par le workflow de reapprovisionnement :
# ROUTEROS_TRANSPORT=
# MIKHMON_VARIANT=
# MIKHMON_BASE_URL=
# MIKHMON_HOTSPOT_SERVER=
# MIKHMON_PROFILE=
# MIKHMON_PROFILES=
# Seuils et lots du workflow de reapprovisionnement :
# TICKET_THRESHOLD=
# TICKET_QUANTITY=
# TICKET_PREFIX=
# TICKET_LIMIT_UPTIME=
# TICKET_LIMIT_BYTES_TOTAL=
# Livraison :
# DELIVERY_CHANNEL=
# DELIVERY_RECIPIENT=
# APPROVAL_RECIPIENT=
# WHATSAPP_WEBHOOK_URL=
# PRINTNODE_API_KEY=
# PRINTNODE_PRINTER_ID=
# PDF_SERVICE_URL=
# TENANT_ID=
