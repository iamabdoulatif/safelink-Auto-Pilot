# Copie ce fichier en "n8n/.env" (charge automatiquement par docker compose),
# puis mets TES vraies valeurs. Ne le commite jamais.
# Generer les secrets : openssl rand -hex 32
GENERIC_TIMEZONE=Africa/Abidjan
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# URL publique des webhooks (convertie en WEBHOOK_URL pour n8n 1.x dans le compose).
N8N_WEBHOOK_URL=http://localhost:5678/
# Nombre de proxys inverses devant n8n (0 en local direct).
N8N_PROXY_HOPS=0
# Ancien nom lu par n8n 1.x : laisse vide, le compose le remplit depuis N8N_WEBHOOK_URL.
WEBHOOK_URL=
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
N8N_ENCRYPTION_KEY=
ROUTEROS_BASE_URL=
ROUTEROS_USER=
ROUTEROS_PASSWORD=
# TLS : certificat verifie par defaut ("", absent). Labo autosigne
# uniquement avec 1 (jamais en production).
ROUTEROS_TLS_INSECURE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_ID=
N8N_WEBHOOK_SECRET=
N8N_CALLBACK_SECRET=
APP_URL=http://host.docker.internal:3000
SIMULATION=true
REAPPRO_SIMULATION=
ROUTEROS_TRANSPORT=
MIKHMON_VARIANT=v3
MIKHMON_BASE_URL=
MIKHMON_HOTSPOT_SERVER=
MIKHMON_PROFILE=
MIKHMON_PROFILES=
TICKET_THRESHOLD=50
TICKET_QUANTITY=
TICKET_PREFIX=
TICKET_LIMIT_UPTIME=
TICKET_LIMIT_BYTES_TOTAL=
DELIVERY_CHANNEL=
DELIVERY_RECIPIENT=
APPROVAL_RECIPIENT=
WHATSAPP_WEBHOOK_URL=
PRINTNODE_API_KEY=
PRINTNODE_PRINTER_ID=
PDF_SERVICE_URL=http://gotenberg:3000/forms/chromium/convert/html
TENANT_ID=
