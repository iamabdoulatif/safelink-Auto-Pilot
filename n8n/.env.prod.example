# Copie ce fichier en "n8n/.env" SUR LE VPS puis mets TES vraies valeurs.
# Ne le commite jamais. Generer les secrets : openssl rand -hex 32.
# Rappel : en prod, AUCUNE adresse locale (localhost, 127.0.0.1,
# host.docker.internal) — voir docs/deploiement-vps.md.

# --- domaines publics (HTTPS via Caddy) ---
N8N_HOST=n8n.exemple.tld
APP_HOST=app.exemple.tld

# --- PostgreSQL interne (jamais expose) ---
POSTGRES_USER=autopilot
POSTGRES_PASSWORD=
POSTGRES_DB=autopilot

# --- n8n : secrets OBLIGATOIRES (le compose refuse de demarrer sans) ---
N8N_BASIC_AUTH_PASSWORD=
# Cle de chiffrement n8n : sauvegardee HORS VPS (perdue = credentials a refaire).
N8N_ENCRYPTION_KEY=
# DOIVENT matcher web/.env.local en production :
N8N_WEBHOOK_SECRET=
N8N_CALLBACK_SECRET=

# --- routeur vu DEPUIS le VPS (VPN/tunnel/IP dediee, jamais d'admin public) ---
ROUTEROS_BASE_URL=
ROUTEROS_USER=n8n-vouchers
ROUTEROS_PASS=
# TLS : certificat verifie par defaut ; labo uniquement avec 1.
ROUTEROS_TLS_INSECURE=

# --- Mikhmon vu DEPUIS le VPS (jamais 127.0.0.1) ---
MIKHMON_BASE_URL=
MIKHMON_VARIANT=v3
MIKHMON_PROFILE=03-JOURS
MIKHMON_HOTSPOT_SERVER=all

# --- tickets et livraison ---
TICKET_THRESHOLD=50
TICKET_QUANTITY=120
TICKET_PREFIX=
TICKET_LIMIT_UPTIME=
TICKET_LIMIT_BYTES_TOTAL=
DELIVERY_CHANNEL=interface
DELIVERY_RECIPIENT=
TELEGRAM_BOT_TOKEN=
WHATSAPP_WEBHOOK_URL=
PRINTNODE_API_KEY=
PRINTNODE_PRINTER_ID=0

# --- divers ---
REAPPRO_SIMULATION=true
